{
  "name": "shipguard",
  "version": "0.1.0",
  "description": "Policy gate and self-correcting guardrail for AI-driven Salesforce releases, built to extend Copado Agentia CLI.",
  "type": "module",
  "bin": { "shipguard": "bin/shipguard.js", "shipguard-mcp": "src/mcp/server.js" },
  "main": "src/index.js",
